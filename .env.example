# ============================================================
# Required
# ============================================================

GOOGLE_API_KEY=your_google_api_key          # always needed (embeddings + default LLM)
LANGCHAIN_API_KEY=your_langsmith_api_key    # LangSmith tracing

# ============================================================
# LLM provider — pick one
# ============================================================

LLM_PROVIDER=google                         # google | anthropic | openai
LLM_MODEL=gemini-3.1-flash-lite

# ANTHROPIC_API_KEY=your_anthropic_api_key  # required when LLM_PROVIDER=anthropic
# OPENAI_API_KEY=your_openai_api_key        # required when LLM_PROVIDER=openai

# ============================================================
# LangSmith tracing (optional)
# ============================================================

LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=graph-theory-paper-gen

# ============================================================
# Optional overrides (defaults shown)
# ============================================================

# EMBEDDING_MODEL=models/gemini-embedding-001
# MAX_GAPS=5
# MIN_RELEVANCE_SCORE=0.5
# CLEAR_DB_ON_RUN=true
# GEMINI_RPM_LIMIT=15
# BATCH_SIZE=3
# BATCH_DELAY_SECONDS=4
